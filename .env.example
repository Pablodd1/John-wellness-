# SERVER-SIDE ONLY: enables live AI research briefs (/api/research) and any
# other server functions. NEVER prefix this with VITE_ — a VITE_ prefix embeds
# the key into the public browser bundle. Set it in your hosting provider's
# environment variables (e.g. Vercel -> Settings -> Environment Variables).
GEMINI_API_KEY="your-server-side-gemini-api-key"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:4173"
